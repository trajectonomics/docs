---
import { ClientRouter } from "astro:transitions"
import appleTouchIcon from "@trajectonomics/design-system-assets/favicon/apple-touch-icon.png?url"
import faviconIco from "@trajectonomics/design-system-assets/favicon/favicon.ico?url"
import faviconSvg from "@trajectonomics/design-system-assets/favicon/favicon.svg?url"
import icon192 from "@trajectonomics/design-system-assets/favicon/icon-192.png?url"
import icon512 from "@trajectonomics/design-system-assets/favicon/icon-512.png?url"
import "../styles/global.css"

interface Props {
	title: string
	description?: string | undefined
}

const { title, description } = Astro.props
---

<html lang="en" data-theme="light" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<link rel="icon" type="image/x-icon" sizes="any" href={faviconIco} />
		<link rel="icon" type="image/png" sizes="192x192" href={icon192} />
		<link rel="icon" type="image/png" sizes="512x512" href={icon512} />
		<link rel="apple-touch-icon" href={appleTouchIcon} />
		<script is:inline>
			// Keep data-theme in step with the .dark class Fumadocs' theme script sets,
			// so the design-system Theme CSS (scoped to [data-theme]) follows the toggle.
			;(function () {
				const root = document.documentElement
				let stored = null
				try {
					stored = window.localStorage.getItem("theme")
				} catch {}
				const dark =
					stored === "dark" ||
					(stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches)
				root.dataset.theme = dark ? "dark" : "light"
				new MutationObserver(() => {
					root.dataset.theme = root.classList.contains("dark") ? "dark" : "light"
				}).observe(root, { attributes: true, attributeFilter: ["class"] })
			})()
		</script>
		<ClientRouter />
	</head>
	<body class="flex flex-col min-h-screen">
		<slot />
	</body>
</html>
