{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trajectonomics-docs",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	// No "routes" on purpose: the route to trajectonomics.com/docs is added later (ADR 0003).
	"assets": {
		// astro.config.ts builds into dist/docs, so /docs/... URLs resolve under ./dist.
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
